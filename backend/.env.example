# Supabase Configuration (Client-side - safe to expose)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Server-side ONLY - NEVER put in Flutter app!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Backend API
# Canonical prefix: the backend mounts every endpoint under /api/v1
# (see backend/src/index.ts) and the Flutter app calls <origin>/api/v1/...
API_BASE_URL=https://api.kargomnerede.com/api/v1
# HTTP port (this is the variable index.ts actually reads;
# Render injects its own PORT automatically)
PORT=3000

# Runtime
# development | production  (Render: production)
NODE_ENV=development

# Browser CORS allowlist, comma separated. Empty = no browser origin gets
# CORS headers. The Flutter app is not a browser and never needs this.
CORS_ORIGIN=https://kargomnerede.com

# Tracking provider (REAL tracking data)
# Exactly one of: ship24 | 17track | aftership   (| mock = development only)
#
# Without these variables the tracking endpoints fail loudly with
# 503 PROVIDER_NOT_CONFIGURED instead of returning synthetic data.
# Never put API keys in the Flutter app or in source code.
TRACKING_PROVIDER=ship24
TRACKING_SHIP24_API_KEY=

# Alternative providers (set TRACKING_PROVIDER accordingly and fill ONE key):
# TRACKING_PROVIDER=17track
# TRACKING_17TRACK_API_KEY=
#
# TRACKING_PROVIDER=aftership
# TRACKING_AFTERSHIP_API_KEY=
#
# Development only - explicitly opt-in mock data, never a silent fallback:
# TRACKING_PROVIDER=mock

# Update Site Configuration
DOWNLOAD_URL=/downloads/KargomNerede.apk
UPDATE_SITE_URL=https://kargomnerede.com