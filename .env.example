# Supabase Configuration (Client-side - safe to expose)
# These are public anon keys that can be safely used in Flutter app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Server-side ONLY - NEVER put in Flutter app!)
# Used for admin operations like updating app_config table
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Backend API
API_BASE_URL=https://api.kargomnerede.com/v1
BACKEND_PORT=3000

# Update Site Configuration
DOWNLOAD_URL=/downloads/KargomNerede.apk
UPDATE_SITE_URL=https://kargomnerede.com